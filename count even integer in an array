#include <stdio.h>
int main() 
{
    int n;
    int arr[100]; 
    int max = 0;
    int streak = 0;
    scanf("%d", &n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    for (int i = 0; i < n; i++) {
        if (arr[i] % 2 == 0) {
            streak++; 
            if (streak > max) {
                max = streak; 
            }
        } else {
            streak = 0; 
        }
    }
    printf(" %d\n", max);

    return 0;
}
