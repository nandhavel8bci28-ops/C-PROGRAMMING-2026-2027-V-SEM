#include<stdio.h>
#include<stdlib.h>
int countStudents(int* students, int studentssize, int* sandwiches, int sandwichesSize) {
    int maxqueuesize= studentssize * studentssize;
    int*queue=(int*)malloc(maxqueuesize*sizeof(int));
    int front=0;
    int rear=0;
for(int i=0;i<studentssize;i++){
    queue[rear++]=students[i];
}
int sandwichIdX=0;
int attempts=0;
while (front<rear && attempts<(rear-front))
{
    if (queue[front]==sandwiches[sandwichIdX]){
        front++;
        sandwichIdX++;
        attempts=0;
    }
        else{
            queue[rear++]=queue[front++];
            attempts++;
        }
    }
    free(queue);
    return rear-front;
}
